# =============================================================================
# Copy to .env and adjust. Used both by `npm run dev` (host) and by
# `docker compose` (full stack). Docker Compose reads this file automatically.
# =============================================================================

# --- NextAuth (Auth.js v5) --------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Public base URL of the app. In production set to your real URL.
AUTH_URL="http://localhost:3000"
# Trust the host header (needed behind proxies / in containers).
AUTH_TRUST_HOST="true"

# --- Database ---------------------------------------------------------------
# For `npm run dev` on the host (Postgres reachable on localhost).
# NOTE: Docker Compose ignores this and builds DATABASE_URL from the
# POSTGRES_* values below, pointing at the internal `db` service.
DATABASE_URL="postgresql://tilgang:tilgang@localhost:5432/tilgangsstyring?schema=public"

# --- Docker Compose: Postgres -----------------------------------------------
POSTGRES_USER="tilgang"
POSTGRES_PASSWORD="tilgang"          # CHANGE in production
POSTGRES_DB="tilgangsstyring"
# Host ports published by compose (change if already in use).
DB_PORT="5432"
APP_PORT="3000"

# --- Optional: bootstrap an initial ADMIN user on first boot ----------------
# If set, the container creates this ADMIN once (idempotent). Lets a fresh
# deploy have a working login without running the seed manually.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Administrator"

# --- Optional: Microsoft Entra ID SSO (prepared, disabled by default) -------
AUTH_ENTRA_ENABLED="false"
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# --- E-mail / expiry reminders ----------------------------------------------
# SMTP (e.g. SMTP2GO) is configured in the app under Settings → E-post (SMTP),
# not here. To enable the scheduled expiry-reminder endpoint, set a secret and
# call POST /api/cron/expiry-reminders with "Authorization: Bearer $CRON_SECRET"
# from a scheduled task (e.g. daily). Generate with: openssl rand -base64 32
CRON_SECRET=""
