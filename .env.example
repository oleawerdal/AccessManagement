# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Override host/port if you run Postgres elsewhere.
DATABASE_URL="postgresql://tilgang:tilgang@localhost:5432/tilgangsstyring?schema=public"

# --- NextAuth (Auth.js v5) --------------------------------------------------
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
# Base URL of the app. In production set to the public URL.
AUTH_URL="http://localhost:3000"
# Trust the host header (needed behind proxies / in containers).
AUTH_TRUST_HOST="true"

# --- Optional: Microsoft Entra ID SSO (prepared, disabled by default) -------
# Fill these in and set AUTH_ENTRA_ENABLED=true to enable SSO later.
AUTH_ENTRA_ENABLED="false"
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
