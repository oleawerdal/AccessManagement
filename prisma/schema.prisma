// Tilgangsstyring — Prisma schema
// Data model for documenting who has which access in internal systems.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums -------------------------------------------------------------------

enum AdminRole {
  ADMIN
  AUDITOR
}

enum EmploymentType {
  EMPLOYEE // ansatt
  CONSULTANT // konsulent
  EXTERNAL // ekstern
  INTERN // praktikant
}

enum AssignmentSource {
  DIRECT
  GROUP
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  GRANT
  REVOKE
  LOGIN
  LOGIN_FAILED
  EXPORT
}

// --- Models ------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Audit logs reference this admin, but we keep logs even if the admin is
  // deleted (adminEmail is duplicated onto each log). Hence SetNull, not Cascade.
  auditLogs   AuditLog[]           @relation("AuditLogAdmin")
  resetTokens PasswordResetToken[]
}

model Person {
  id             String         @id @default(cuid())
  firstName      String
  lastName       String
  email          String         @unique
  employeeId     String?        @unique
  department     String?
  jobTitle       String?
  employmentType EmploymentType @default(EMPLOYEE)
  startDate      DateTime?
  endDate        DateTime?
  active         Boolean        @default(true)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignments      RoleAssignment[]
  memberships      GroupMembership[]
  ownedSystems     System[]          @relation("SystemOwner")
  resourceAccesses ResourceAccess[]
  ownedResources   Resource[]        @relation("ResourceOwner")

  @@index([lastName, firstName])
  @@index([active])
}

model System {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String?
  ownerEmail  String?
  // Preferred: the system owner is a Person in the registry. ownerEmail is
  // kept for backwards compatibility / external import.
  ownerPersonId String?
  ownerPerson   Person? @relation("SystemOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  url         String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles Role[]

  @@index([ownerPersonId])
}

model Role {
  id          String    @id @default(cuid())
  systemId    String
  system      System    @relation(fields: [systemId], references: [id], onDelete: Cascade)
  name        String
  description String?
  riskLevelId String
  riskLevel   RiskLevel @relation(fields: [riskLevelId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignments RoleAssignment[]
  groupRoles  GroupRole[]

  @@unique([systemId, name])
  @@index([systemId])
  @@index([riskLevelId])
}

// Configurable risk levels (Settings). Replaces the former fixed enum so
// admins can add/edit/remove levels with their own label, colour and
// description. `severity` orders them (higher = riskier).
model RiskLevel {
  id          String   @id @default(cuid())
  label       String   @unique
  description String?
  color       String   @default("#64748b")
  severity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles     Role[]
  resources Resource[]

  @@index([severity])
}

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groupRoles  GroupRole[]
  memberships GroupMembership[]
}

model GroupRole {
  id               String   @id @default(cuid())
  groupId          String
  group            Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roleId           String
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  defaultExpiryDays Int?
  createdAt        DateTime @default(now())

  @@unique([groupId, roleId])
  @@index([groupId])
  @@index([roleId])
}

model GroupMembership {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())
  addedBy   String?

  @@unique([personId, groupId])
  @@index([personId])
  @@index([groupId])
}

model RoleAssignment {
  id            String           @id @default(cuid())
  personId      String
  person        Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedAt     DateTime         @default(now())
  grantedBy     String?
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedBy     String?
  revokeReason  String?
  source        AssignmentSource @default(DIRECT)
  sourceGroupId String?
  notes         String?
  // Set when an expiry notification has been sent, so the reminder job emails
  // about a given expired assignment only once.
  expiryNotifiedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Same role cannot be granted to the same person twice via the same source.
  @@unique([personId, roleId, source])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([personId])
  @@index([roleId])
}

// --- Physical / non-system access -------------------------------------------
// A separate module for physical things (doors, gates, cars, …) that people
// need access to. Kept alongside System/Role rather than merged into it,
// because a physical resource has no "roles" and access is instead obtained
// through a method (physical key, app, keycard, …). Reuses the same audit,
// expiry and risk-level infrastructure as the digital access model.

// Configurable kind of physical resource (Dør, Port, Bil, …). Like RiskLevel,
// admins manage these in Settings instead of them being a fixed enum.
model ResourceType {
  id          String   @id @default(cuid())
  label       String   @unique
  description String?
  // Optional lucide-react icon name shown in the UI (e.g. "DoorOpen", "Car").
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resources Resource[]
}

// Configurable way of obtaining access (Fysisk nøkkel, App, Nøkkelkort, …).
// `requiresCredential` marks methods that hand out a physical token whose
// identifier (card/key number) should be tracked and collected on revocation.
model AccessMethod {
  id                 String   @id @default(cuid())
  label              String   @unique
  description        String?
  requiresCredential Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  accesses ResourceAccess[]
}

// A physical thing that can be accessed.
model Resource {
  id            String       @id @default(cuid())
  name          String       @unique
  description   String?
  typeId        String
  type          ResourceType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  // Free-text physical location, e.g. "Bygg A – 1. etasje".
  location      String?
  // Physical identifier of the resource itself, e.g. registreringsnummer,
  // dørnummer or anleggsmiddel-ID.
  identifier    String?
  riskLevelId   String?
  riskLevel     RiskLevel?   @relation(fields: [riskLevelId], references: [id], onDelete: SetNull)
  ownerPersonId String?
  ownerPerson   Person?      @relation("ResourceOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accesses ResourceAccess[]

  @@index([typeId])
  @@index([riskLevelId])
  @@index([ownerPersonId])
}

// A person's right to access a resource, obtained via a specific method.
model ResourceAccess {
  id           String       @id @default(cuid())
  personId     String
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  methodId     String
  method       AccessMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  // Identifier of the issued physical token (card/key number), when the method
  // requires one. Lets you know exactly which item to collect on offboarding.
  credentialId String?
  grantedAt    DateTime     @default(now())
  grantedBy    String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  // Tracks whether an issued physical credential has been handed back. Relevant
  // for offboarding so no key/card is left outstanding after access is revoked.
  credentialReturned   Boolean   @default(false)
  credentialReturnedAt DateTime?
  notes                String?
  // Set when an expiry notification has been sent, so the reminder job emails
  // about a given expired access only once.
  expiryNotifiedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Same resource cannot be granted to the same person twice via the same method.
  @@unique([personId, resourceId, methodId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([personId])
  @@index([resourceId])
  @@index([methodId])
}

// Machine-to-machine credentials for the external REST API (/api/v1). The full
// token is shown to the operator once at creation and never stored; only a
// SHA-256 hash is kept. `prefix` is a short, non-secret identifier so a key can
// be recognised in the UI and logs without revealing the secret.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String    @unique
  keyHash    String    @unique
  role       AdminRole @default(ADMIN)
  active     Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active])
}

// Outgoing-mail (SMTP) configuration. Single-row table (fixed id "default"),
// editable by an admin in Settings. `password` is write-only — it is never
// returned to the client.
model SmtpSettings {
  id        String   @id @default("default")
  host      String
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String?
  password  String?
  fromEmail String
  fromName  String   @default("Tilgangsstyring")
  enabled   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Single sign-on (Microsoft Entra ID) configuration, editable in Settings.
// Single-row table (fixed id "default"). `clientSecret` is write-only — never
// returned to the client. Takes precedence over the AUTH_ENTRA_* env vars.
model SsoSettings {
  id           String   @id @default("default")
  enabled      Boolean  @default(false)
  clientId     String?
  clientSecret String?
  issuer       String?
  updatedBy    String?
  updatedAt    DateTime @updatedAt
}

// Single-use, hashed tokens for the "set / reset password" e-mail flow.
model PasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

model AuditLog {
  id          String      @id @default(cuid())
  timestamp   DateTime    @default(now())
  adminUserId String?
  adminUser   AdminUser?  @relation("AuditLogAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  // Duplicated so the log survives deletion of the admin user.
  adminEmail  String
  action      AuditAction
  entityType  String
  entityId    String?
  entityLabel String?
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?

  @@index([timestamp])
  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([action])
}
